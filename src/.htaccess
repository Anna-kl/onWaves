# ============================================================
# Angular SPA — Apache configuration
# ============================================================

<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On

  # --- SPA fallback: serve index.html for all non-file/dir routes ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ============================================================
# Cache-Control headers
# ============================================================
<IfModule mod_headers.c>

    # index.html — NEVER cache (Safari must always fetch fresh)
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </FilesMatch>

    # Service worker and PWA manifest — never cache
    # iOS Safari caches these aggressively; stale ngsw-worker.js = blank screen after deploy
    <FilesMatch "^(ngsw-worker\.js|ngsw\.json|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </FilesMatch>

    # Angular hashed bundles (main.abc12345.js, styles.abc12345.css)
    # Content hash guarantees uniqueness — safe to cache forever
    <FilesMatch "\.[0-9a-f]{8,}\.(js|mjs|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Static assets: icons, fonts, images bundled with the app
    # User photos are served from onwaves-server.online (different origin, not affected here)
    <FilesMatch "\.(ico|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>

</IfModule>

# ============================================================
# MIME types
# ============================================================
<IfModule mod_mime.c>
    AddType application/manifest+json    webmanifest
    AddType application/javascript       mjs
    AddType text/javascript              js
    AddType font/woff2                   woff2
    AddType font/woff                    woff
</IfModule>
